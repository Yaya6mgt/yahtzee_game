<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
        x:Class="Yahtzee.UI.MainWindow"
        Title="Yahtzee Deluxe - Industrial Programming CW1"
        Width="1150" Height="780"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Navigation Header -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" Padding="16,10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <!-- Logo Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="YAHTZEE DELUXE" FontSize="16" FontWeight="Black" Foreground="{DynamicResource GoldLuxuryBrush}" VerticalAlignment="Center" LetterSpacing="1.5"/>
                    <Border Background="{DynamicResource GoldContainerBrush}" BorderBrush="{DynamicResource GoldLuxuryBrush}" BorderThickness="1" CornerRadius="2" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text=".NET 10" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource GoldLuxuryBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button x:Name="NavNewGameBtn" Content="New Game" Background="{DynamicResource PrimaryContainerBrush}" Foreground="{DynamicResource TextPrimaryBrush}" CornerRadius="4" Padding="14,6" FontWeight="SemiBold" Click="OnNavNewGameClicked"/>
                    <Button x:Name="NavSaveGameBtn" Content="Save Game" Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextSecondaryBrush}" CornerRadius="4" Padding="14,6" FontWeight="SemiBold" Click="OnNavSaveGameClicked"/>
                    <Button x:Name="NavLoadGameBtn" Content="Load Game" Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextSecondaryBrush}" CornerRadius="4" Padding="14,6" FontWeight="SemiBold" Click="OnNavLoadGameClicked"/>
                    <Button x:Name="NavHighScoresBtn" Content="High Scores" Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextSecondaryBrush}" CornerRadius="4" Padding="14,6" FontWeight="SemiBold" Click="OnNavHighScoresClicked"/>
                </StackPanel>

                <!-- Status & Exit Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Exit" Background="{DynamicResource RoseBrush}" Foreground="White" CornerRadius="4" Padding="14,6" FontWeight="SemiBold" Click="OnNavExitClicked"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Row="1" x:Name="MainContentHost"/>

        <!-- Status Bar Footer -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBgBrush}" Padding="16,6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock x:Name="StatusText" Text="Ready - F20SC Industrial Programming CW1" FontSize="11" Foreground="{DynamicResource PrimaryContainerBrush}"/>
                <TextBlock Grid.Column="1" Text="Yahtzee CW1 v1.00.01" FontSize="11" Foreground="{DynamicResource PrimaryContainerBrush}"/>
            </Grid>
        </Border>

        <!-- Save before exit Confirmation Modal -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                x:Name="SavePromptOverlay"
                Background="#D0121214"
                IsVisible="False">
            <Border Background="{DynamicResource CardBgBrush}"
                    Width="460"
                    CornerRadius="14"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 10 30 0 #A0000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="Unsaved Game In Progress" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="You have an active game with unsaved changes. Would you like to save your game before exiting?"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>

                    <Grid ColumnDefinitions="*, *, *">
                        <Button Grid.Column="0" Content="Save &amp; Exit" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" Click="OnPromptSaveAndExitClicked"/>
                        <Button Grid.Column="1" Content="Don't Save" Margin="4,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource RoseBrush}" Foreground="White" Click="OnPromptDontSaveClicked"/>
                        <Button Grid.Column="2" Content="Cancel" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource BorderSubtleBrush}" Foreground="White" Click="OnPromptCancelClicked"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>
