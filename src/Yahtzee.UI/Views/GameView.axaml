<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Yahtzee.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Yahtzee.UI.Views.GameView">

    <Grid RowDefinitions="Auto, *">

        <!-- Top Status & VIP Casino Action Bar -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" Padding="16,12" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Border Grid.Column="0" Background="{DynamicResource PrimaryContainerBrush}" CornerRadius="8" Padding="14,7" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="🏆" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RoundText" Text="ROUND 1 / 13" FontWeight="Black" Foreground="{DynamicResource PrimaryLightBrush}" FontSize="13" LetterSpacing="0.8"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <Border Background="{DynamicResource WindowBgBrush}" CornerRadius="20" Padding="18,6" BorderBrush="{DynamicResource GoldLuxuryBrush}" BorderThickness="1.5" BoxShadow="0 2 10 0 #30000000">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock x:Name="TurnIconText" Text="👑" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TurnText" Text="Alice's Turn" FontWeight="Black" Foreground="{DynamicResource GoldLuxuryBrush}" FontSize="15"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="RollsBadge" Background="{DynamicResource PrimaryContainerBrush}" CornerRadius="16" Padding="14,6" BorderBrush="{DynamicResource PrimaryLightBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="🎲" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RollsText" Text="3 Rolls Remaining" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Column="2"
                        x:Name="SaveGameBtn"
                        Content="💾 Save Game"
                        Background="{DynamicResource CardBgBrush}"
                        Foreground="{DynamicResource GoldLuxuryBrush}"
                        BorderBrush="{DynamicResource GoldBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,7"
                        FontWeight="Bold"
                        Click="OnSaveGameClicked"/>
            </Grid>
        </Border>

        <!-- Main Workspace (Dice Cup + Casino Scorecard) -->
        <Grid Grid.Row="1" ColumnDefinitions="400, *">

            <Border Grid.Column="0" Background="{DynamicResource CasinoDarkFeltBrush}" Padding="20" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto, *, Auto, Auto">
                    <Border Grid.Row="0" Background="#16221D" CornerRadius="8" Padding="14,10" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🎲" FontSize="16"/>
                                <TextBlock Text="VIP DICE CUP" FontSize="13" FontWeight="Black" Foreground="{DynamicResource GoldLuxuryBrush}" LetterSpacing="1"/>
                            </StackPanel>
                            <TextBlock Text="Click a die to HOLD before rolling remaining dice" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <UniformGrid Grid.Row="1" Rows="3" Columns="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:DiceControl x:Name="Die0" Margin="8"/>
                        <controls:DiceControl x:Name="Die1" Margin="8"/>
                        <controls:DiceControl x:Name="Die2" Margin="8"/>
                        <controls:DiceControl x:Name="Die3" Margin="8"/>
                        <controls:DiceControl x:Name="Die4" Margin="8"/>
                    </UniformGrid>

                    <Border Grid.Row="2"
                            x:Name="AiStatusBanner"
                            Background="#1F1708"
                            BorderBrush="{DynamicResource GoldLuxuryBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,12"
                            IsVisible="False">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="🤖" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AiStatusText" Text="Computer is thinking..." Foreground="{DynamicResource GoldBrightBrush}" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="3"
                            x:Name="RollBtn"
                            Content="🎲 ROLL DICE (3)"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Height="56"
                            FontSize="17"
                            FontWeight="Black"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="White"
                            CornerRadius="12"
                            BorderBrush="{DynamicResource GoldBrightBrush}"
                            BorderThickness="1"
                            Click="OnRollClicked"/>
                </Grid>
            </Border>

            <!-- Right Column: VIP Scorecard Grid & Previews -->
            <Border Grid.Column="1" Background="{DynamicResource HeaderBgBrush}" Padding="16">
                <Grid RowDefinitions="Auto, *, Auto">

                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="4" x:Name="PlayerTabsContainer"/>
                        </ScrollViewer>
                        <Border Grid.Column="1" Background="{DynamicResource WindowBgBrush}" Padding="8,4" BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="Select a category to score" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <StackPanel x:Name="ScorecardRowsContainer" Spacing="2"/>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{DynamicResource WindowBgBrush}" Padding="0" BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*, *, *, *">

                            <Border Grid.Column="0" Padding="10" BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="0,0,1,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="UPPER SECTION" FontSize="10" Foreground="{DynamicResource PrimaryLightBrush}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="UpperSubtotalText" Text="0 / 63 pts" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Sum of 1s to 6s" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Padding="10" BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="0,0,1,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="+35 PTS BONUS" FontSize="10" Foreground="{DynamicResource PrimaryLightBrush}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="UpperBonusText" Text="0 pt" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Unlocked at 63 pts" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Padding="10" BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="0,0,1,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="LOWER SECTION" FontSize="10" Foreground="{DynamicResource PrimaryLightBrush}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LowerTotalText" Text="0 pt" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Poker &amp; Combinations" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Padding="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="VIP GRAND TOTAL" FontSize="10" Foreground="{DynamicResource GoldBorderBrush}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="GrandTotalText" Text="0 PTS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource GoldLuxuryBrush}"/>
                                    <TextBlock Text="Final Score" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Game Over Modal -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                x:Name="GameOverOverlay"
                Background="#EE0A0C10"
                IsVisible="False">
            <Border Background="#141822"
                    Width="520"
                    CornerRadius="16"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource GoldLuxuryBrush}"
                    BorderThickness="2"
                    BoxShadow="0 15 40 0 #A0000000">
                <StackPanel Spacing="18">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <TextBlock Text="👑" FontSize="30"/>
                        <TextBlock Text="VIP GAME OVER!" FontSize="24" FontWeight="Black" Foreground="{DynamicResource GoldBrightBrush}" VerticalAlignment="Center" LetterSpacing="1"/>
                        <TextBlock Text="👑" FontSize="30"/>
                    </StackPanel>

                    <TextBlock x:Name="WinnerText" Text="Alice wins with 285 Points!" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>

                    <Border Background="#0C0E14" CornerRadius="10" Padding="14" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1">
                        <StackPanel x:Name="FinalStandingsContainer" Spacing="8"/>
                    </Border>

                    <Grid ColumnDefinitions="*, *">
                        <Button Grid.Column="0" Content="High Scores" Margin="0,0,6,0" Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource GoldLightBrush}" Foreground="White" BorderBrush="{DynamicResource BorderHighlightBrush}" BorderThickness="1" CornerRadius="8" FontWeight="SemiBold" Click="OnGameOverViewHighScoresClicked"/>
                        <Button Grid.Column="1" Content="Play Again 🎲" Margin="6,0,0,0" Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource PrimaryBrush}" Foreground="White" CornerRadius="8" FontWeight="Black" Click="OnGameOverPlayAgainClicked"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
