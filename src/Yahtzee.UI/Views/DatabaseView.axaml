<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Yahtzee.UI.Views.DatabaseView">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="{DynamicResource HeaderBgBrush}" Padding="24">
            <StackPanel Spacing="20" MaxWidth="800" HorizontalAlignment="Center">

                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="GAMES DATABASE &amp; LEADERBOARD"
                               FontSize="26"
                               FontWeight="Black"
                               Foreground="{DynamicResource GoldBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Filter Controls Bar -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="16">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="TopOverallBtn" Content="Top 5 Overall" Background="{DynamicResource PrimaryContainerBrush}" Foreground="White" CornerRadius="6" Click="OnFilterTabClicked"/>
                            <Button x:Name="TopByPlayerBtn" Content="Top 5 By Player" Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource TextSecondaryBrush}" CornerRadius="6" Click="OnFilterTabClicked"/>
                            <Button x:Name="RecentHistoryBtn" Content="Match History" Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource TextSecondaryBrush}" CornerRadius="6" Click="OnFilterTabClicked"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" x:Name="PlayerSearchContainer" IsVisible="False">
                            <TextBox x:Name="PlayerSearchInput"
                                     PlaceholderText="Enter player name..."
                                     Width="180"
                                     Background="{DynamicResource HeaderBgBrush}"
                                     CornerRadius="6"
                                     BorderBrush="{DynamicResource BorderSubtleBrush}"
                                     Foreground="{DynamicResource TextDarkBrush}"/>

                            <Button Content="Search"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Foreground="White"
                                    CornerRadius="0"
                                    Padding="12,6"
                                    FontWeight="SemiBold"
                                    Click="OnPlayerSearchClicked"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Leaderboard Table Container -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="60, *, 120, 100, 160" Margin="8,0,8,6">
                            <TextBlock Grid.Column="0" Text="RANK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="PLAYER NAME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="2" Text="SCORE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="3" Text="TYPE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="4" Text="DATE PLAYED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>

                        <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1"/>

                        <StackPanel x:Name="LeaderboardRowsContainer" Spacing="6"/>

                        <TextBlock x:Name="EmptyStateText"
                                   Text="No game records found yet."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="0,20"
                                   IsVisible="False"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
