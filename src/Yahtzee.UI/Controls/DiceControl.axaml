<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="120" d:DesignHeight="140"
             x:Class="Yahtzee.UI.Controls.DiceControl">
    
    <Grid RowDefinitions="Auto, *">
        <!-- Held Status Badge -->
        <Border Grid.Row="0"
                x:Name="HeldBadge"
                HorizontalAlignment="Center"
                Margin="0,0,0,6"
                Padding="8,2"
                CornerRadius="4"
                Background="#F59E0B"
                IsVisible="False">
            <TextBlock Text="🔒 HELD"
                       Foreground="#1E1B4B"
                       FontSize="11"
                       FontWeight="Bold"/>
        </Border>

        <!-- Die Body Card -->
        <Border Grid.Row="1"
                x:Name="DieCard"
                Width="90"
                Height="90"
                CornerRadius="14"
                Background="#F8FAFC"
                BorderBrush="#94A3B8"
                BorderThickness="3"
                BoxShadow="0 4 12 0 #40000000"
                PointerPressed="OnDieClicked"
                Cursor="Hand">
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Border.Transitions>

            <Grid Margin="12">
                <!-- Die Pips (Dots) Grid (3x3) -->
                <!-- Grid Positions:
                     (0,0) (0,1) (0,2)
                     (1,0) (1,1) (1,2)
                     (2,0) (2,1) (2,2) -->
                <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*,*">
                    <!-- Top-Left -->
                    <Ellipse Grid.Row="0" Grid.Column="0" x:Name="Pip00" Width="14" Height="14" Fill="#0F172A" IsVisible="False"/>
                    <!-- Top-Right -->
                    <Ellipse Grid.Row="0" Grid.Column="2" x:Name="Pip02" Width="14" Height="14" Fill="#0F172A" IsVisible="False"/>
                    <!-- Middle-Left -->
                    <Ellipse Grid.Row="1" Grid.Column="0" x:Name="Pip10" Width="14" Height="14" Fill="#0F172A" IsVisible="False"/>
                    <!-- Center -->
                    <Ellipse Grid.Row="1" Grid.Column="1" x:Name="Pip11" Width="14" Height="14" Fill="#0F172A" IsVisible="False"/>
                    <!-- Middle-Right -->
                    <Ellipse Grid.Row="1" Grid.Column="2" x:Name="Pip12" Width="14" Height="14" Fill="#0F172A" IsVisible="False"/>
                    <!-- Bottom-Left -->
                    <Ellipse Grid.Row="2" Grid.Column="0" x:Name="Pip20" Width="14" Height="14" Fill="#0F172A" IsVisible="False"/>
                    <!-- Bottom-Right -->
                    <Ellipse Grid.Row="2" Grid.Column="2" x:Name="Pip22" Width="14" Height="14" Fill="#0F172A" IsVisible="False"/>
                </Grid>

                <!-- Value Fallback Number Overlay -->
                <TextBlock x:Name="ValueText"
                           Text="1"
                           FontSize="36"
                           FontWeight="Black"
                           Foreground="#0F172A"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
