<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- YAHTZEE DELUXE DESIGN SYSTEM - EMERALD & CHARCOAL PALETTE         -->
    <!-- (theme: White cream, Emerald Green, Warm Gold & Crimson)     -->
    <!-- ================================================================= -->

<!-- Base Colors (Warm Ivory & Sand) -->
    <Color x:Key="WindowBgColor">#FAF8F5</Color>
    <Color x:Key="HeaderBgColor">#F6EFE0</Color>
    <Color x:Key="CardBgColor">#FFFFFF</Color>
    <Color x:Key="CardBgHoverColor">#E8E4DC</Color>
    <Color x:Key="InputBgColor">#71C0A3</Color>
    <Color x:Key="CasinoFeltColor">#0D261E</Color>
    <Color x:Key="CasinoDarkFeltColor">#061813</Color>

    <!-- Primary Accent (Emerald Green & Jade) -->
    <Color x:Key="PrimaryColor">#10B981</Color>
    <Color x:Key="PrimaryHoverColor">#059669</Color>
    <Color x:Key="PrimaryLightColor">#34D399</Color>
    <Color x:Key="PrimaryContainerColor">#064E3B</Color>

    <!-- Secondary Accent (Royal Metallic Gold & Champagne) -->
    <Color x:Key="GoldColor">#F59E0B</Color>
    <Color x:Key="GoldHoverColor">#D97706</Color>
    <Color x:Key="GoldLightColor">#FBBF24</Color>
    <Color x:Key="GoldContainerColor">#451A03</Color>

    <!-- Creative Matching Accent (Deep Royal Velvet Crimson & Rose) -->
    <Color x:Key="RoseColor">#BE123C</Color>
    <Color x:Key="RoseHoverColor">#9F1239</Color>
    <Color x:Key="RoseContainerColor">#3F0E18</Color>
    <Color x:Key="WineAccentColor">#8B152B</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#2F5C4D</Color>
    <Color x:Key="TextMutedColor">#A7CEC0</Color>
    <Color x:Key="TextDarkColor">#0C150C</Color>

    <!-- Luxury Accents (Gold Metallic & Platinum) -->
    <Color x:Key="GoldLuxuryColor">#D4AF37</Color>
    <Color x:Key="GoldBrightColor">#FFD700</Color>
    <Color x:Key="SilverColor">#E2E8F0</Color>

    <!-- Borders (Warm Gold & Charcoal Borders) -->
    <Color x:Key="BorderSubtleColor">#243325</Color>
    <Color x:Key="BorderHighlightColor">#374A36</Color>

    <!-- ================================================================= -->
    <!-- SOLID COLOR BRUSHES                                              -->
    <!-- ================================================================= -->

    <!-- Surfaces & Backgrounds -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}"/>
    <SolidColorBrush x:Key="CardBgHoverBrush" Color="{StaticResource CardBgHoverColor}"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="GlassBgBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="CasinoFeltBrush" Color="{StaticResource CasinoFeltColor}"/>
    <SolidColorBrush x:Key="CasinoDarkFeltBrush" Color="{StaticResource CasinoDarkFeltColor}"/>

    <!-- Primary Accent Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}"/>

    <!-- Gold Accent Brushes -->
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="GoldHoverBrush" Color="{StaticResource GoldHoverColor}"/>
    <SolidColorBrush x:Key="GoldLightBrush" Color="{StaticResource GoldLightColor}"/>
    <SolidColorBrush x:Key="GoldContainerBrush" Color="{StaticResource GoldContainerColor}"/>
    <SolidColorBrush x:Key="GoldLuxuryBrush" Color="{StaticResource GoldLuxuryColor}"/>
    <SolidColorBrush x:Key="GoldBrightBrush" Color="{StaticResource GoldBrightColor}"/>
    <SolidColorBrush x:Key="GoldBorderBrush" Color="#80D4AF37"/>
    <SolidColorBrush x:Key="GoldGlowBrush" Color="#33D4AF37"/>

    <!-- Royal Crimson & Wine Brushes -->
    <SolidColorBrush x:Key="RoseBrush" Color="{StaticResource RoseColor}"/>
    <SolidColorBrush x:Key="RoseHoverBrush" Color="{StaticResource RoseHoverColor}"/>
    <SolidColorBrush x:Key="RoseContainerBrush" Color="{StaticResource RoseContainerColor}"/>
    <SolidColorBrush x:Key="WineAccentBrush" Color="{StaticResource WineAccentColor}"/>

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextDarkBrush" Color="{StaticResource TextDarkColor}"/>

    <!-- Border Brushes -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="BorderHighlightBrush" Color="{StaticResource BorderHighlightColor}"/>

</ResourceDictionary>
