<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- YAHTZEE DELUXE DESIGN SYSTEM - EMERALD & CHARCOAL PALETTE         -->
    <!-- (theme: Obsidian, Emerald Green, Warm Gold & Crimson)     -->
    <!-- ================================================================= -->

    <!-- Base Colors -->
    <Color x:Key="WindowBgColor">#121214</Color>
    <Color x:Key="HeaderBgColor">#1B1C20</Color>
    <Color x:Key="CardBgColor">#23252B</Color>
    <Color x:Key="CardBgHoverColor">#2D3038</Color>
    <Color x:Key="InputBgColor">#18191D</Color>

    <!-- Primary Accent (Emerald Green) -->
    <Color x:Key="PrimaryColor">#10B981</Color>
    <Color x:Key="PrimaryHoverColor">#059669</Color>
    <Color x:Key="PrimaryLightColor">#34D399</Color>
    <Color x:Key="PrimaryContainerColor">#064E3B</Color>

    <!-- Secondary Accent (Warm Gold / Amber) -->
    <Color x:Key="GoldColor">#F59E0B</Color>
    <Color x:Key="GoldHoverColor">#D97706</Color>
    <Color x:Key="GoldLightColor">#FBBF24</Color>
    <Color x:Key="GoldContainerColor">#451A03</Color>

    <!-- Danger Accent (Crimson Rose) -->
    <Color x:Key="RoseColor">#E11D48</Color>
    <Color x:Key="RoseHoverColor">#BE123C</Color>
    <Color x:Key="RoseContainerColor">#4C0519</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#F4F4F5</Color>
    <Color x:Key="TextSecondaryColor">#A1A1AA</Color>
    <Color x:Key="TextMutedColor">#71717A</Color>
    <Color x:Key="TextDarkColor">#18181B</Color>

    <!-- Luxury Accents (Gold Metallic & Silver) -->
    <Color x:Key="GoldLuxuryColor">#D4AF37</Color>
    <Color x:Key="SilverColor">#E2E8F0</Color>

    <!-- Borders -->
    <Color x:Key="BorderSubtleColor">#2E3138</Color>
    <Color x:Key="BorderHighlightColor">#3F434D</Color>

    <!-- ================================================================= -->
    <!-- SOLID COLOR BRUSHES                                              -->
    <!-- ================================================================= -->

    <!-- Surfaces & Backgrounds -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}"/>
    <SolidColorBrush x:Key="CardBgHoverBrush" Color="{StaticResource CardBgHoverColor}"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="GlassBgBrush" Color="#EE1B1C20"/>

    <!-- Primary Accent Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}"/>

    <!-- Gold Accent Brushes -->
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="GoldHoverBrush" Color="{StaticResource GoldHoverColor}"/>
    <SolidColorBrush x:Key="GoldLightBrush" Color="{StaticResource GoldLightColor}"/>
    <SolidColorBrush x:Key="GoldContainerBrush" Color="{StaticResource GoldContainerColor}"/>
    <SolidColorBrush x:Key="GoldLuxuryBrush" Color="{StaticResource GoldLuxuryColor}"/>
    <SolidColorBrush x:Key="GoldBorderBrush" Color="#66D4AF37"/>

    <!-- Silver Brushes -->
    <SolidColorBrush x:Key="SilverBrush" Color="{StaticResource SilverColor}"/>

    <!-- Danger Brushes -->
    <SolidColorBrush x:Key="RoseBrush" Color="{StaticResource RoseColor}"/>
    <SolidColorBrush x:Key="RoseHoverBrush" Color="{StaticResource RoseHoverColor}"/>
    <SolidColorBrush x:Key="RoseContainerBrush" Color="{StaticResource RoseContainerColor}"/>

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextDarkBrush" Color="{StaticResource TextDarkColor}"/>

    <!-- Border Brushes -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="BorderHighlightBrush" Color="{StaticResource BorderHighlightColor}"/>

</ResourceDictionary>
